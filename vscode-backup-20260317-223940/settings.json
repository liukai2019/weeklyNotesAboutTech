    "http.proxySupport": "off",
    "editor.renderWhitespace": "none",
    "prettier.tabWidth": 4,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "remote.autoForwardPortsSource": "hybrid",
