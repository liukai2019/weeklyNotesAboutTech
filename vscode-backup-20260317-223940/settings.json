  "[tcl]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false,
    "editor.wordWrap": "on",
    "files.eol": "\\n",
    "editor.fontSize": 14,
    "editor.wordWrapColumn": 120
  },
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.indentation": true,
  "editor.wordWrapColumn": 120,
  "files.associations": {
    "*.tcl": "tcl",
    "*.tk": "tcl",
    "*.test": "tcl"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.git": true
  },

  "editor.fontFamily": "Cascadia Code, Fira Code, Consolas, 'Courier New', monospace",
  "editor.fontSize": 15,
  "editor.lineHeight": 26,
  "editor.letterSpacing": 0.2,
  "editor.fontLigatures": true,
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "smooth",
  "editor.minimap.enabled": false,
  "editor.padding.top": 12,
  "editor.padding.bottom": 12,
  "editor.mouseWheelZoom": true,

  "workbench.colorCustomizations": {
    "editor.background": "#FBF5EE",
    "editor.foreground": "#2C2C2C",
    "editorLineNumber.foreground": "#8B6F47",
    "editorLineNumber.activeForeground": "#5A3F2A",
    "editor.selectionBackground": "#F1E3C8",
    "editor.inactiveSelectionBackground": "#F6E9D6",
    "editor.lineHighlightBackground": "#FFF2D9",
    "editorCursor.foreground": "#6B4C3B",
    "editorIndentGuide.background": "#EFE2CA",
    "editorIndentGuide.activeBackground": "#E6D0B1",
    "sideBar.background": "#F7F1E7",
    "activityBar.background": "#F6EDE1",
    "statusBar.background": "#EDE1D5",
    "tab.activeBackground": "#FFF8EE",
    "tab.inactiveBackground": "#F6EFE6"
  },

  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment, punctuation.definition.comment",
        "settings": {
          "foreground": "#8B7760",
          "fontStyle": "italic"
        }
      },
      {
        "scope": "keyword, storage.type, storage.modifier",
        "settings": {
          "foreground": "#B85C38",
          "fontStyle": "bold"
        }
      },
      {
        "scope": "string, constant.other.symbol",
        "settings": {
          "foreground": "#D96A2B"
        }
      },
      {
        "scope": "constant.numeric, constant.language",
        "settings": {
          "foreground": "#9B5C00"
        }
      },
      {
        "scope": "entity.name.function, support.function",
        "settings": {
          "foreground": "#2E6F61"
        }
      },
      {
        "scope": "variable, variable.parameter",
        "settings": {
          "foreground": "#6B4C3B"
        }
      },
      {
        "scope": "entity.name.type, support.type",
        "settings": {
          "foreground": "#7E3F3F"
        }
      },
      {
        "scope": "punctuation, meta.brace",
        "settings": {
          "foreground": "#4B3A2C"
        }
      }
    ]
  },
  "search.sortOrder": "modified",
  "explorer.sortOrder": "modified",
  "claudeCodeChat.wsl.enabled": false,
  "claudeCodeChat.wsl.distro": "Ubuntu",
  "claudeCodeChat.wsl.nodePath": "/usr/bin/node",
