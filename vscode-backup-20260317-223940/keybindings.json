// Place your key bindings in this file to override the defaults
[
    {
        "key": "alt+n",
        "command": "search.action.focusSearchList"
    },
    {
        "key": "alt+j",
        "command": "editorScroll",
        "args": {
            "by": "line",
            "to": "down",
            "value": 2,
            "revealCursor": true
        },
        "when": "editorTextFocus"
    },
    {
        "key": "alt+h",
        "command": "scrollLeft",
        "args": {
            "by": "line",
            "to": "left",
            "value": 2,
            "revealCursor": true
        },
        "when": "editorTextFocus"
    },
    {
        "key": "alt+l",
        "command": "scrollRight",
        "args": {
            "by": "line",
            "to": "right",
            "value": 2,
            "revealCursor": true
        },
        "when": "editorTextFocus"
    },
    {
        "key": "alt+k",
        "command": "editorScroll",
        "args": {
            "to": "up",
            "by": "line",
            "value": 2,
            "revealCursor": true
        },
        "when": "editorTextFocus"
    },
    {
        "key": "alt+s",
        "command": "cursorDown",
        "when": "textInputFocus"
    },
    {
        "key": "down",
        "command": "-cursorDown",
        "when": "textInputFocus"
    },
    {
        "key": "alt+w",
        "command": "-toggleSearchEditorWholeWord",
        "when": "inSearchEditor && searchInputBoxFocus"
    },
    {
        "key": "alt+w",
        "command": "-workbench.action.terminal.toggleFindWholeWord",
        "when": "terminalFindFocused && terminalHasBeenCreated || terminalFindFocused && terminalProcessSupported || terminalFocusInAny && terminalHasBeenCreated || terminalFocusInAny && terminalProcessSupported"
    },
    {
        "key": "alt+w",
        "command": "-toggleFindWholeWord",
        "when": "editorFocus"
    },
    {
        "key": "alt+w",
        "command": "-toggleSearchWholeWord",
        "when": "searchViewletFocus"
    },
    {
        "key": "alt+w",
        "command": "cursorUp",
        "when": "textInputFocus"
    },
    {
        "key": "up",
        "command": "-cursorUp",
        "when": "textInputFocus"
    },
    {
        "key": "alt+a",
        "command": "cursorLeft",
        "when": "textInputFocus"
    },
    {
        "key": "left",
        "command": "-cursorLeft",
        "when": "textInputFocus"
    },
    {
        "key": "alt+d",
        "command": "cursorRight",
        "when": "textInputFocus"
    },
    {
        "key": "right",
        "command": "-cursorRight",
        "when": "textInputFocus"
    },
    {
        "key": "alt+g",
        "command": "workbench.action.showAllSymbols"
    },
    {
        "key": "ctrl+t",
        "command": "-workbench.action.showAllSymbols"
    },
    {
        "key": "ctrl+t",
        "command": "-extension.vim_ctrl+t",
        "when": "editorTextFocus && vim.active && vim.use<C-t> && !inDebugRepl"
    },
    {
        "key": "ctrl+t",
        "command": "workbench.action.quickOpen"
    },
    {
        "key": "ctrl+e",
        "command": "-workbench.action.quickOpen"
    },
    {
        "key": "shift+alt+s",
        "command": "editor.action.revealDefinition",
        "when": "editorHasDefinitionProvider && editorTextFocus"
    },
    {
        "key": "f12",
        "command": "-editor.action.revealDefinition",
        "when": "editorHasDefinitionProvider && editorTextFocus"
    },
    {
        "key": "shift+alt+a",
        "command": "-editor.action.blockComment",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "shift+alt+a",
        "command": "workbench.action.navigateBack",
        "when": "canNavigateBack"
    },
    {
        "key": "alt+left",
        "command": "-workbench.action.navigateBack",
        "when": "canNavigateBack"
    },
    {
        "key": "shift+alt+d",
        "command": "-editor.detectLanguage",
        "when": "editorTextFocus && !notebookEditable"
    },
    {
        "key": "shift+alt+d",
        "command": "-notebook.cell.detectLanguage",
        "when": "notebookCellEditable && notebookEditable"
    },
    {
        "key": "shift+alt+d",
        "command": "workbench.action.navigateForward",
        "when": "canNavigateForward"
    },
    {
        "key": "alt+right",
        "command": "-workbench.action.navigateForward",
        "when": "canNavigateForward"
    },
    {
        "key": "f8",
        "command": "-editor.action.marker.nextInFiles",
        "when": "editorFocus"
    },
    {
        "key": "f8",
        "command": "highlightwords.addHighlight"
    },
    {
        "key": "down",
        "command": "cursorDown",
        "when": "textInputFocus"
    },
    {
        "key": "up",
        "command": "cursorUp",
        "when": "textInputFocus"
    },
    {
        "key": "left",
        "command": "cursorLeft",
        "when": "textInputFocus"
    },
    {
        "key": "right",
        "command": "cursorRight",
        "when": "textInputFocus"
    },
    {
        "key": "shift+alt+r",
        "command": "workbench.action.files.revealActiveFileInWindows"
    },
    {
        "key": "ctrl+k r",
        "command": "-workbench.action.files.revealActiveFileInWindows"
    },
    {
        "key": "alt+f10",
        "command": "-editor.action.nextCommentedRangeAction",
        "when": "activeEditorHasCommentingRange"
    },
    {
        "key": "alt+f10",
        "command": "github.copilot.chat.explain"
    },
    {
        "key": "space",
        "command": "list.select",
        "when": "listFocus && !inputFocus && !treestickyScrollFocused"
    },
    {
        "key": "alt+s",
        "command": "list.focusDown",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "alt+w",
        "command": "list.focusUp",
        "when": "listFocus && !inputFocus && !treestickyScrollFocused"
    },
    {
        "key": "alt+a",
        "command": "list.collapse",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "alt+d",
        "command": "list.expand",
        "when": "listFocus && treeElementCanExpand && !inputFocus && !treestickyScrollFocused || listFocus && treeElementHasChild && !inputFocus && !treestickyScrollFocused"
    },
    {
        "key": "l",
        "command": "list.expand",
        "when": "listFocus && treeElementCanExpand && !inputFocus && !treestickyScrollFocused || listFocus && treeElementHasChild && !inputFocus && !treestickyScrollFocused"
    },
    {
        "key": "ctrl+shift+r",
        "command": "-rerunSearchEditorSearch",
        "when": "inSearchEditor"
    },
    {
        "key": "ctrl+shift+r",
        "command": "-workbench.action.quickOpenNavigatePreviousInRecentFilesPicker",
        "when": "inQuickOpen && inRecentFilesPicker"
    },
    {
        "key": "ctrl+shift+q",
        "command": "-workbench.action.quickOpenNavigatePreviousInViewPicker",
        "when": "inQuickOpen && inViewsPicker"
    },
    {
        "key": "alt+q",
        "command": "search.action.clearSearchResults"
    },
    {
        "key": "alt+f1",
        "command": "-editor.action.accessibilityHelp",
        "when": "!accessibilityHelpIsShown"
    },
    {
        "key": "alt+f2",
        "command": "-workbench.action.terminal.focusAccessibleBuffer",
        "when": "accessibilityModeEnabled && terminalFocus && terminalHasBeenCreated || accessibilityModeEnabled && terminalFocus && terminalProcessSupported"
    },
    {
        "key": "alt+f2",
        "command": "-editor.action.accessibleView"
    },
    {
        "key": "alt+f1",
        "command": "github.copilot.chat.explain"
    },
    {
        "key": "alt+f2",
        "command": "workbench.action.chat.openInEditor"
    },
    {
        "key": "ctrl+alt+s",
        "command": "editor.action.indentationToSpaces"
    },
    {
        "key": "ctrl+k ctrl+shift+alt+h",
        "command": "workbench.action.splitEditorLeft"
    },
    {
        "key": "ctrl+k ctrl+shift+alt+j",
        "command": "workbench.action.splitEditorDown"
    },
    {
        "key": "ctrl+k ctrl+shift+alt+k",
        "command": "workbench.action.splitEditorUp"
    },
    {
        "key": "ctrl+k ctrl+shift+alt+l",
        "command": "workbench.action.splitEditorRight"
    },
    {
        "key": "ctrl+shift+alt+h",
        "command": "workbench.action.focusLeftGroup"
    },
    {
        "key": "ctrl+shift+alt+j",
        "command": "workbench.action.focusBelowGroup"
    },
    {
        "key": "ctrl+shift+alt+k",
        "command": "workbench.action.focusAboveGroup"
    },
    {
        "key": "ctrl+shift+alt+l",
        "command": "workbench.action.focusRightGroup"
    },
    {
        "key": "ctrl+b",
        "command": "-markdown.extension.editing.toggleBold",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
    },
    {
        "key": "ctrl+l",
        "command": "-expandLineSelection",
        "when": "editorTextFocus && editorLangId == markdown"
    },
    {
        "key": "ctrl+l ctrl+j",
        "command": "runCommands",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "args": {
            "commands": [
                "cursorHome",
                "expandLineSelection",
                {
                    "command": "editor.action.insertSnippet",
                    "args": {
                        "snippet": "${TM_SELECTED_TEXT/^(\\s*)(?:-\\s\\[[ xX]\\]\\s*)?(.*?)(?:\\s*@\\s*\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2})?\\s*$/$1- [ ] $2/}"
                    }
                }
            ]
        }
    },
    {
        "key": "ctrl+l ctrl+k",
        "command": "runCommands",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "args": {
            "commands": [
                "cursorHome",
                "expandLineSelection",
                {
                    "command": "editor.action.insertSnippet",
                    "args": {
                        "snippet": "${TM_SELECTED_TEXT/^(\\s*)(?:-\\s\\[[ xX]\\]\\s*)?(.*?)(?:\\s*@\\s*\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2})?\\s*$/$1- [x] $2/}"
                    }
                }
            ]
        }
    },
    {
        "key": "ctrl+l ctrl+n",
        "command": "workbench.action.tasks.runTask",
        "args": "New Timestamp Note"
    },
    {
        "key": "ctrl+k ctrl+w",
        "command": "-workbench.action.closeAllEditors"
    },
    {
        "key": "ctrl+k ctrl+w",
        "command": "workbench.action.closeOtherEditors"
    },
    {
        "key": "ctrl+k ctrl+o",
        "command": "workbench.action.closeEditorsInOtherGroups"
    },
    {
        "key": "ctrl+k ctrl+g",
        "command": "workbench.action.joinAllGroups"
    },
    {
        "key": "ctrl+k ctrl+m",
        "command": "-editor.changeLanguageMode",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+k ctrl+m",
        "command": "workbench.action.toggleMaximizeEditorGroup"
    }
]